# Copy to .env and fill in with your CognoDB Cloud instance details.
# .env is gitignored — never commit real credentials.

# Bolt connection URI from the CognoDB console.
# Form: bolt+s://<instance-id>.databases.cognodb.com
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.com

# Username shown in the console (always "cognodb" on the free tier).
COGNODB_USER=cognodb

# Generated password — shown exactly once at instance creation.
COGNODB_PASSWORD=

# Optional. Leave unset to use the server's default database.
# COGNODB_DATABASE=neo4j

# Optional. Max Bolt connections held open by this process.
# The free c0 tier caps the instance at 200 across all clients.
# COGNODB_MAX_POOL_SIZE=20
